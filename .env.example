# ==============================================================================
# TEKNIX MONOREPO — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# NUNCA INSERIR VALORES SECRETOS NESTE ARQUIVO. UTILIZAR APENAS COMO REFERÊNCIA.
# ==============================================================================

# --- SUPABASE (BANCO DE DADOS & STORAGE) ---
NEXT_PUBLIC_SUPABASE_URL=https://ykgprfzfnffooqmfbeox.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://ykgprfzfnffooqmfbeox.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- DOMÍNIOS E PORTAS OFICIAIS TEKNIX ---
# SITE (E-commerce oficial): http://localhost:5173 -> https://teknixbrasil.com.br
NEXT_PUBLIC_SITE_URL=https://teknixbrasil.com.br
VITE_SITE_URL=https://teknixbrasil.com.br

# FLOW (Operação de marketplaces): http://localhost:3000 -> https://flow.teknixbrasil.com.br
NEXT_PUBLIC_FLOW_URL=https://flow.teknixbrasil.com.br

# HUB (Painel administrativo do site/loja): http://localhost:5174 -> https://hub.teknixbrasil.com.br
NEXT_PUBLIC_HUB_URL=https://hub.teknixbrasil.com.br
VITE_HUB_URL=https://hub.teknixbrasil.com.br

# PLAY (Checkout e fluxo de pagamento): http://localhost:5173/checkout -> https://play.teknixbrasil.com.br
NEXT_PUBLIC_PLAY_URL=https://play.teknixbrasil.com.br
VITE_PLAY_URL=https://play.teknixbrasil.com.br

# API (API central e integrações): http://localhost:3000/api -> https://api.teknixbrasil.com.br
NEXT_PUBLIC_API_URL=https://api.teknixbrasil.com.br

# AUTH (Autenticação, 2FA e sessão): http://localhost:5173/login -> https://auth.teknixbrasil.com.br
NEXT_PUBLIC_AUTH_URL=https://auth.teknixbrasil.com.br

# NOTIFICATIONS & MAIL: mail.teknixbrasil.com.br / notifications.teknixbrasil.com.br
NEXT_PUBLIC_NOTIFICATIONS_URL=https://notifications.teknixbrasil.com.br
BREVO_MAIL_DOMAIN=mail.teknixbrasil.com.br

# SECURITY (Central de segurança): http://localhost:3000/api/security -> https://security.teknixbrasil.com.br
NEXT_PUBLIC_SECURITY_URL=https://security.teknixbrasil.com.br

# --- BREVO (E-MAIL TRANSACIONAL & MARKETING) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=contato@teknixbrasil.com.br
BREVO_SENDER_NAME=TEKNIX Brasil

# --- MERCADO LIVRE (INTEGRAÇÃO OFICIAL) ---
MERCADOLIVRE_CLIENT_ID=your_mercadolivre_app_id_here
MERCADOLIVRE_CLIENT_SECRET=your_mercadolivre_client_secret_here
MERCADOLIVRE_REDIRECT_URI=https://flow.teknixbrasil.com.br/api/integrations/mercadolivre/callback
MERCADOLIVRE_WEBHOOK_URL=https://api.teknixbrasil.com.br/webhooks/mercadolivre

# --- SHOPEE (INTEGRAÇÃO OFICIAL) ---
SHOPEE_PARTNER_ID=your_shopee_partner_id_here
SHOPEE_PARTNER_KEY=your_shopee_partner_key_here
SHOPEE_WEBHOOK_URL=https://api.teknixbrasil.com.br/webhooks/shopee

# --- AMAZON (SP-API) ---
AMAZON_CLIENT_ID=your_amazon_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_WEBHOOK_URL=https://api.teknixbrasil.com.br/webhooks/amazon

# --- GATEWAYS DE PAGAMENTO (CHECKOUT PLAY) ---
PAYMENT_GATEWAY_API_KEY=your_gateway_key_here
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
