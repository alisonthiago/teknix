{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @teknix/site build",
  "outputDirectory": "apps/site/dist",
  "headers": [
    {
      "source": "/integracoes/melhor-envio/teste",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/webhooks/melhor-envio", "destination": "/api/webhooks/melhor-envio" },
    { "source": "/oauth/melhor-envio/authorize", "destination": "/api/oauth/melhor-envio/authorize" },
    { "source": "/oauth/melhor-envio/callback", "destination": "/api/oauth/melhor-envio/callback" },
    {
      "source": "/((?!api(?:/|$)|webhooks(?:/|$)|oauth(?:/|$)).*)",
      "destination": "/"
    }
  ]
}
