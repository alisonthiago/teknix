{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/webhooks/melhor-envio",
      "destination": "/api/webhooks/melhor-envio"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sync-orders",
      "schedule": "0 6 * * *"
    }
  ]
}
