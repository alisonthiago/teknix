# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Roteia AI (OpenAI-compatible) — https://api.roteia.ai/v1
VITE_ROTEIA_BASE_URL=https://api.roteia.ai/v1
VITE_ROTEIA_API_KEY=rt-live-YOUR_KEY
VITE_ROTEIA_MODEL=openai/gpt-5.6-sol

# Brevo transactional email
VITE_BREVO_API_KEY=YOUR_BREVO_API_KEY
VITE_BREVO_SENDER_EMAIL=your-sender@example.com
VITE_BREVO_SENDER_NAME=TEKNIX Brasil
